<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Royal Mark Hotel | Sylhet</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
font-family:Arial,sans-serif;
}

.navbar{
background:#002B5B;
}

.navbar-brand,.nav-link{
color:white!important;
font-weight:bold;
}

.hero{
height:100vh;
background:linear-gradient(rgba(0,0,0,.5),rgba(0,0,0,.5)),
url("https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1600&q=80");
background-size:cover;
background-position:center;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
color:white;
}

.hero h1{
font-size:60px;
font-weight:bold;
}

.btn-gold{
background:#D4AF37;
color:white;
}

.section-title{
text-align:center;
margin:60px 0 30px;
font-weight:bold;
color:#002B5B;
}

.card img{
height:220px;
object-fit:cover;
}

footer{
background:#002B5B;
color:white;
padding:30px;
text-align:center;
margin-top:60px;
}

</style>

</head>

<body>

<nav class="navbar navbar-expand-lg">
<div class="container">

<a class="navbar-brand" href="#">Royal Mark Hotel</a>

<button class="navbar-toggler bg-light" data-bs-toggle="collapse" data-bs-target="#menu">
<span class="navbar-toggler-icon"></span>
</button>

<div class="collapse navbar-collapse" id="menu">

<ul class="navbar-nav ms-auto">

<li class="nav-item"><a class="nav-link" href="#">Home</a></li>

<li class="nav-item"><a class="nav-link" href="#">Rooms</a></li>

<li class="nav-item"><a class="nav-link" href="#">Restaurant</a></li>

<li class="nav-item"><a class="nav-link" href="#">Gallery</a></li>

<li class="nav-item"><a class="nav-link" href="#">Contact</a></li>

</ul>

</div>

</div>
</nav>

<section class="hero">

<div>

<h1>Welcome to Royal Mark Hotel</h1>

<p>Luxury Stay in Sylhet</p>

<a href="#" class="btn btn-gold btn-lg">Book Now</a>

</div>

</section>

<div class="container">

<h2 class="section-title">Our Rooms</h2>

<div class="row">

<div class="col-md-4">

<div class="card">

<img src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=800&q=80">

<div class="card-body">

<h4>Deluxe Room</h4>

<p>Modern luxury room with free breakfast.</p>

</div>

</div>

</div>

<div class="col-md-4">

<div class="card">

<img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=800&q=80">

<div class="card-body">

<h4>Executive Room</h4>

<p>Premium facilities with city view.</p>

</div>

</div>

</div>

<div class="col-md-4">

<div class="card">

<img src="https://images.unsplash.com/photo-1445019980597-93fa8acb246c?auto=format&fit=crop&w=800&q=80">

<div class="card-body">

<h4>Suite Room</h4>

<p>Luxury suite for family & business guests.</p>

</div>

</div>

</div>

</div>

</div>

<footer>

<h4>Royal Mark Hotel</h4>

<p>Sylhet, Bangladesh</p>

<p>Phone : +8801XXXXXXXXX</p>

<p>Email : info@royalmarkhotel.com</p>

</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
